<h2 style="text-align:center; margin-bottom:22px; font-size:1.3rem;">Admin Login</h2>
<form action="/admin/login" method="POST">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="form-field">
    <label for="email">Email</label>
    <input type="email" id="email" name="email" required autofocus>
  </div>
  <div class="form-field">
    <label for="password">Password</label>
    <input type="password" id="password" name="password" required>
  </div>
  <button type="submit" class="btn btn--gold btn--block">Log In</button>
</form>
<p style="text-align:center; margin-top:20px;"><a href="/" style="font-size:0.85rem; color:var(--text-muted);">&larr; Back to website</a></p>
