<form action="<%= (testimonial ? '/admin/testimonials/' + testimonial._id : '/admin/testimonials') %>?_csrf=<%= encodeURIComponent(csrfToken) %>" method="POST" enctype="multipart/form-data">
  <div class="admin-form-grid">
    <div class="admin-panel-section">
      <h3>Testimonial Details</h3>
      <div class="form-grid">
        <div class="form-field"><label for="name">Customer Name</label><input type="text" id="name" name="name" value="<%= testimonial ? testimonial.name : '' %>" required></div>
        <div class="form-field"><label for="location">Location</label><input type="text" id="location" name="location" value="<%= testimonial ? testimonial.location : '' %>"></div>
      </div>
      <div class="form-field">
        <label for="rating">Rating</label>
        <select id="rating" name="rating">
          <% [5,4,3,2,1].forEach(function(r) { %><option value="<%= r %>" <%= testimonial && testimonial.rating === r ? 'selected' : '' %>><%= r %> Star<%= r > 1 ? 's' : '' %></option><% }) %>
        </select>
      </div>
      <div class="form-field"><label for="review">Review</label><textarea id="review" name="review" rows="4" required><%= testimonial ? testimonial.review : '' %></textarea></div>
      <div class="form-field"><label for="photo">Customer Photo (optional)</label><input type="file" id="photo" name="photo" accept="image/jpeg,image/png,image/webp"></div>
      <% if (testimonial && testimonial.photoUrl) { %><img src="<%= testimonial.photoUrl %>" class="admin-thumb" style="width:70px; height:70px; border-radius:50%; margin-top:8px;" alt=""><% } %>
    </div>
    <div class="admin-panel-section">
      <h3>Publish</h3>
      <div class="form-field"><label for="order">Display Order</label><input type="number" id="order" name="order" value="<%= testimonial ? testimonial.order : 0 %>"></div>
      <label style="display:flex; align-items:center; gap:8px; margin-bottom:18px;"><input type="checkbox" name="published" <%= (!testimonial || testimonial.published) ? 'checked' : '' %>> Published</label>
      <button type="submit" class="btn btn--gold btn--block"><%= testimonial ? 'Save Changes' : 'Add Testimonial' %></button>
      <a href="/admin/testimonials" class="btn btn--ghost btn--block" style="margin-top:10px;">Cancel</a>
    </div>
  </div>
</form>
