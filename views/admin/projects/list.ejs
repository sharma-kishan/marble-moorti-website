<div class="admin-panel">
  <div class="admin-panel__head">
    <h3 style="margin:0; font-size:1.05rem;">Temple Projects</h3>
    <a href="/admin/projects/new" class="btn btn--gold btn--sm">+ Add Project</a>
  </div>
  <% if (projects.length) { %>
  <table class="admin-table">
    <thead><tr><th>Image</th><th>Title</th><th>Location</th><th>Status</th><th>Actions</th></tr></thead>
    <tbody>
      <% projects.forEach(function(p) { %>
      <tr>
        <td><% if (p.coverUrl) { %><img src="<%= p.coverUrl %>" class="admin-thumb" alt=""><% } %></td>
        <td><%= p.title %></td>
        <td><%= p.location %></td>
        <td><span class="status-pill <%= p.published ? 'status-Confirmed' : 'status-Cancelled' %>"><%= p.published ? 'Published' : 'Unpublished' %></span></td>
        <td style="white-space:nowrap;">
          <a href="/admin/projects/<%= p._id %>/edit" class="btn btn--ghost btn--sm">Edit</a>
          <form action="/admin/projects/<%= p._id %>/delete" method="POST" class="inline-form" data-confirm="Delete this project?">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn--ghost btn--sm">Delete</button>
          </form>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <% } else { %>
    <div class="empty-state">No temple projects yet. <a href="/admin/projects/new">Add your first project</a>.</div>
  <% } %>
</div>
