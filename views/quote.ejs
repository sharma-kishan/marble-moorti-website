<section class="section" style="padding-bottom:0;">
  <div class="container">
    <div class="breadcrumbs"><a href="/">Home</a> / Request a Quote</div>
    <div class="section-head fade-in" style="max-width:680px;">
      <span class="eyebrow">Let's Talk</span>
      <h1>Request a Quote</h1>
      <p>Share the details below and our team in Jaipur will respond with sizing, marble options, and pricing.</p>
    </div>
  </div>
</section>

<section class="section--tight">
  <div class="container" style="max-width:820px;">
    <div class="form-card fade-in">
      <form action="/request-quote" method="POST" enctype="multipart/form-data">
        <% if (product) { %>
          <input type="hidden" name="productId" value="<%= product._id %>">
          <input type="hidden" name="product" value="<%= product.name %>">
          <div class="badge-gold" style="margin-bottom:20px;">Enquiring about: <%= product.name %></div>
        <% } %>

        <div class="form-grid">
          <div class="form-field"><label for="name">Full Name</label><input type="text" id="name" name="name" required></div>
          <div class="form-field"><label for="phone">Phone</label><input type="tel" id="phone" name="phone" required></div>
          <div class="form-field"><label for="whatsapp">WhatsApp Number</label><input type="tel" id="whatsapp" name="whatsapp"></div>
          <div class="form-field"><label for="email">Email</label><input type="email" id="email" name="email"></div>
          <div class="form-field"><label for="country">Country</label><input type="text" id="country" name="country" value="India"></div>
          <div class="form-field"><label for="city">City</label><input type="text" id="city" name="city"></div>
          <% if (!product) { %>
          <div class="form-field form-field--full"><label for="product">Required Statue</label><input type="text" id="product" name="product" placeholder="e.g. Ganesh Murti, 24 inch"></div>
          <% } %>
          <div class="form-field"><label for="height">Approximate Height</label><input type="text" id="height" name="height" placeholder="e.g. 24 inches"></div>
          <div class="form-field"><label for="quantity">Quantity</label><input type="number" id="quantity" name="quantity" min="1" value="1"></div>
          <div class="form-field"><label for="marblePreference">Marble Preference</label>
            <select id="marblePreference" name="marblePreference">
              <option value="">No preference</option>
              <option>Makrana White</option>
              <option>Makrana Pink</option>
              <option>Italian Marble</option>
              <option>Green Marble</option>
              <option>Black Marble</option>
            </select>
          </div>
          <div class="form-field"><label for="requiredDate">Required By</label><input type="date" id="requiredDate" name="requiredDate"></div>
          <div class="form-field form-field--full"><label for="deliveryLocation">Delivery Location</label><input type="text" id="deliveryLocation" name="deliveryLocation" placeholder="City, State / Country"></div>
          <div class="form-field form-field--full"><label for="message">Message</label><textarea id="message" name="message" placeholder="Tell us more about what you're looking for…"></textarea></div>
          <div class="form-field form-field--full">
            <label for="referenceImages">Reference Images (optional)</label>
            <input type="file" id="referenceImages" name="referenceImages" accept="image/jpeg,image/png,image/webp" multiple>
            <small>Up to 5 images, JPEG/PNG/WebP.</small>
          </div>
        </div>

        <button type="submit" class="btn btn--gold btn--block">Submit Enquiry</button>
      </form>
    </div>
  </div>
</section>
