<section class="section--tight">
  <div class="container">
    <div class="breadcrumbs"><a href="/">Home</a> / <a href="/temple-projects">Temple Projects</a> / <%= project.title %></div>

    <div class="section-head section-head--left fade-in" style="max-width:760px;">
      <span class="eyebrow"><%= project.location %></span>
      <h1><%= project.title %></h1>
    </div>

    <% if (project.coverUrl) { %>
    <div class="fade-in" style="border-radius:var(--radius-md); overflow:hidden; margin-bottom:40px; box-shadow:var(--shadow-soft);">
      <img src="<%= project.coverUrl %>" alt="<%= project.title %>">
    </div>
    <% } %>

    <div style="display:grid; grid-template-columns: 2fr 1fr; gap:50px;">
      <div class="fade-in">
        <h2>Project Overview</h2>
        <p><%= project.description %></p>
      </div>
      <table class="spec-table fade-in">
        <% if (project.projectType) { %><tr><td>Type</td><td><%= project.projectType %></td></tr><% } %>
        <% if (project.statueSize) { %><tr><td>Statue Size</td><td><%= project.statueSize %></td></tr><% } %>
        <% if (project.marbleType) { %><tr><td>Marble Used</td><td><%= project.marbleType %></td></tr><% } %>
        <% if (project.completionDate) { %><tr><td>Completed</td><td><%= new Date(project.completionDate).toLocaleDateString('en-IN', { year:'numeric', month:'long' }) %></td></tr><% } %>
        <% if (project.servicesProvided && project.servicesProvided.length) { %><tr><td>Services</td><td><%= project.servicesProvided.join(', ') %></td></tr><% } %>
      </table>
    </div>

    <% if (project.images && project.images.length > 1) { %>
    <div class="grid grid--3 fade-in" style="margin-top:50px;">
      <% project.images.slice(1).forEach(function(img) { %>
        <div style="border-radius:var(--radius-md); overflow:hidden; aspect-ratio:4/3;"><img src="<%= img.mediumUrl %>" alt="<%= project.title %>" style="width:100%; height:100%; object-fit:cover;" loading="lazy"></div>
      <% }) %>
    </div>
    <% } %>
  </div>
</section>

<section class="section section--dark" style="text-align:center;">
  <div class="container">
    <h2>Planning a Similar Project?</h2>
    <a href="/request-quote" class="btn btn--gold" style="margin-top:10px;">Request a Quote</a>
  </div>
</section>
