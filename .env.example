# Server
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/marble_moorti

# Auth
JWT_SECRET=change_this_secret_to_a_long_random_string
JWT_EXPIRES_IN=7d
SESSION_SECRET=change_this_session_secret_too
COOKIE_SECURE=false

# Default admin account (used by npm run create-admin)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password

# Business contact (used to seed Site Settings — replace with real info in /admin/settings)
WHATSAPP_NUMBER=
BUSINESS_PHONE=
BUSINESS_EMAIL=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
